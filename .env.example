# ============================================================
# Petit Elle 환경변수 예시
# 04_SYSTEM_ARCHITECTURE.md 16번 기준
#
# 사용법:
#   1) 이 파일을 .env.local 로 복사
#   2) 실제 값 입력 (Supabase 대시보드 → Project Settings → API)
#   3) .env.local 은 절대 커밋하지 않는다 (.gitignore 처리됨)
#
# ※ 현재 V1 은 Mock 데이터로 동작하므로 값이 비어 있어도 빌드/실행된다.
#    실제 연결은 SUPABASE_SETUP_GUIDE.md 참고.
# ============================================================

# --- 사이트 ---
NEXT_PUBLIC_SITE_URL=http://localhost:8080

# --- Supabase (Project Settings → API) ---
# NEXT_PUBLIC_* 는 브라우저에 노출되어도 안전한 anon 키만 사용한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키는 서버에서만 사용. 절대 NEXT_PUBLIC_ 접두사 금지.
SUPABASE_SERVICE_ROLE_KEY=

# --- Kakao OAuth (카카오 디벨로퍼스) ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- Analytics ---
GA_MEASUREMENT_ID=
